                  "linuxFxVersion": "[parameters('runtimeStack')]",
                  "alwaysOn": "[parameters('alwaysOn')]",
                  "minTlsVersion": "1.2",
                  "ftpsState": "Disabled",
                  "appSettings": "[variables('formattedAppSettings')]"
                }
              },
              "tags": "[parameters('tags')]"
            }
          ],
          "outputs": {
            "appServiceId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Web/sites', parameters('name'))]"
            },
            "defaultHostName": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Web/sites', parameters('name')), '2023-12-01').defaultHostName]"
            }
          }
        }
      },
      "dependsOn": [
        "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroup').name), 'Microsoft.Resources/deployments', format('appi-{0}', uniqueString(parameters('resourceGroup').name, parameters('environment'))))]",
        "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroup').name), 'Microsoft.Resources/deployments', format('plan-{0}', uniqueString(parameters('appServicePlan').name)))]"
      ]
    }
  ],
  "outputs": {
    "resourceGroupName": {
      "type": "string",
      "value": "[parameters('resourceGroup').name]"
    },
    "appServiceDefaultHostName": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroup').name), 'Microsoft.Resources/deployments', format('app-{0}', uniqueString(parameters('appService').name))), '2025-04-01').outputs.defaultHostName.value]"
    },
    "sqlServerFullyQualifiedDomainName": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroup').name), 'Microsoft.Resources/deployments', format('sql-{0}', uniqueString(parameters('sqlServer').name))), '2025-04-01').outputs.fullyQualifiedDomainName.value]"
    }
  }
}