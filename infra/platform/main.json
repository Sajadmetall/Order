        "input": "[reference(tenantResourceId('Microsoft.Resources/deployments', format('mg-{0}', uniqueString(parameters('managementGroups')[copyIndex()].name))), '2025-04-01').outputs.managementGroupId.value]"
      }
    },
    "subscriptionAssignmentIds": {
