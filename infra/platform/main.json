          "parentManagementGroupId": "[if(and(contains(parameters('managementGroups')[copyIndex()], 'parent'), not(empty(string(parameters('managementGroups')[copyIndex()].parent)))), createObject('value', tenantResourceId('Microsoft.Management/managementGroups', string(parameters('managementGroups')[copyIndex()].parent))), createObject('value', ''))]"
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-08-01/tenantDeploymentTemplate.json#",
